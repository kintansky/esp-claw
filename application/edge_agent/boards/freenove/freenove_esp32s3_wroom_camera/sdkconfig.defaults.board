# Freenove ESP32-S3-WROOM-1 Camera Board (ESP32-S3-WROOM-1-N16R8):
# 16 MB QIO flash @ 80 MHz, 8 MB octal PSRAM @ 80 MHz.
#
# QIO @ 80 MHz has been verified to work on the WROOM-1-N16R8 module
# that ships with this board. If you see a similar module hang at
# call_start_cpu0 on a different unit, it is most likely the
# "console goes to USB-OTG" issue described in the README (not a
# flash mode problem); fix the console first before downgrading the
# flash mode.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# 8 MB octal PSRAM @ 80 MHz. Wired to the chip's OPI peripheral, so no
# GPIO conflict with the camera/SD/LED wiring.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Put WiFi station / LwIP buffers in PSRAM to free internal RAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Camera frame buffers live in PSRAM; esp_video uses MALLOC_CAP_SPIRAM
# automatically when CONFIG_SPIRAM=y.

# Console + flash: route everything through the on-board USB-UART
# (CH340/CP2102 wired to GPIO43 = U0TXD, GPIO44 = U0RXD).
#
# The Freenove board has TWO USB ports:
#   - USB-UART  : CH340/CP2102 bridge chip connected to GPIO43/44. This
#                 is what most users plug into for flashing + serial
#                 monitor. Console must therefore be UART0.
#   - USB-OTG   : ESP32-S3 native USB on GPIO19/20. Useful for power
#                 delivery or for an external device, but NOT for the
#                 console on this adaptation.
#
# Do NOT enable CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG here — the app's
# log output would go to the OTG port and the user would see no logs
# on the UART port they are actually monitoring.
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE_115200=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Camera: OV5640 over DVP 8-bit, JPEG 1024x768 @ 30 FPS default
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV5640=y
CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5640_DVP_JPEG_1024X768_30FPS=y
CONFIG_CAMERA_OV5640_DVP_DEFAULT_FMT_JPEG_1024X768_30FPS=y
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=y

# WS2812 LED on GPIO48 via RMT0.
CONFIG_APP_CLAW_LUA_MODULE_LED_STRIP=y
